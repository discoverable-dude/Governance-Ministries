# Sanity (leave unset to run from the local seed content in lib/seed.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=governance
SANITY_REVALIDATE_SECRET=

# Canonical origin
NEXT_PUBLIC_SITE_URL=https://www.governanceministries.org

# Contact form (Resend). Without these the form tells people to email directly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@governanceministries.org
CONTACT_FROM_EMAIL=
